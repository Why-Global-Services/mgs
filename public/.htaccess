# Apache / cPanel configuration for Next.js static export
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. If exact file exists (images, css, js, etc.), serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. If exact directory exists and has index.html, serve it
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # 3. If URL without trailing slash corresponds to a directory with index.html, redirect to trailing slash
  RewriteCond %{DOCUMENT_ROOT}/$1 -d
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

  # 4. Support legacy clean URLs with .html file if present
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ /$1.html [L]

  # 5. Support clean URLs mapping to directory index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]

  # 404 error document
  ErrorDocument 404 /404.html
</IfModule>
